    <TIER LINGUISTIC_TYPE_REF="utterance" TIER_ID="ком">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1533"
                TIME_SLOT_REF1="ts38" TIME_SLOT_REF2="ts42">
                <ANNOTATION_VALUE>я запуталась, это один союз</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1872"
                TIME_SLOT_REF1="ts92" TIME_SLOT_REF2="ts103">
                <ANNOTATION_VALUE>жест начинается от головы..</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1876"
                TIME_SLOT_REF1="ts107" TIME_SLOT_REF2="ts119">
                <ANNOTATION_VALUE>я не верю. что это кивок</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1574"
                TIME_SLOT_REF1="ts141" TIME_SLOT_REF2="ts143">
                <ANNOTATION_VALUE>?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1902"
                TIME_SLOT_REF1="ts159" TIME_SLOT_REF2="ts170">
                <ANNOTATION_VALUE>это точно кровать!!!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1615"
                TIME_SLOT_REF1="ts207" TIME_SLOT_REF2="ts213">
                <ANNOTATION_VALUE>прилагательное?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1940"
                TIME_SLOT_REF1="ts239" TIME_SLOT_REF2="ts247">
                <ANNOTATION_VALUE>то ли "и другие плохие вещи, то ли осуждение"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1941"
                TIME_SLOT_REF1="ts288" TIME_SLOT_REF2="ts293">
                <ANNOTATION_VALUE>первая часть жеста что значит..</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1980"
                TIME_SLOT_REF1="ts493" TIME_SLOT_REF2="ts499">
                <ANNOTATION_VALUE>я не знаю значение похоже на "ладно", позволение..</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1638"
                TIME_SLOT_REF1="ts516" TIME_SLOT_REF2="ts519">
                <ANNOTATION_VALUE>передумала говорить Петербург:)</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1856"
                TIME_SLOT_REF1="ts546" TIME_SLOT_REF2="ts547">
                <ANNOTATION_VALUE>ближе к глаголу, чем к прилагательному...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2146"
                TIME_SLOT_REF1="ts632" TIME_SLOT_REF2="ts642">
                <ANNOTATION_VALUE>тут нет жеста, я исправила</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2010"
                TIME_SLOT_REF1="ts955" TIME_SLOT_REF2="ts960">
                <ANNOTATION_VALUE>это не прагматический, у него нет значения</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2059"
                TIME_SLOT_REF1="ts1062" TIME_SLOT_REF2="ts1072">
                <ANNOTATION_VALUE>на "шесть"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2246"
                TIME_SLOT_REF1="ts1111" TIME_SLOT_REF2="ts1114">
                <ANNOTATION_VALUE>проф = профессионально</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2247"
                TIME_SLOT_REF1="ts1135" TIME_SLOT_REF2="ts1137">
                <ANNOTATION_VALUE>в профессиональный [спорт]</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2324"
                TIME_SLOT_REF1="ts1241" TIME_SLOT_REF2="ts1244">
                <ANNOTATION_VALUE>СКС?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2325"
                TIME_SLOT_REF1="ts1245" TIME_SLOT_REF2="ts1253">
                <ANNOTATION_VALUE>это не "там ну", просто такое м</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2106"
                TIME_SLOT_REF1="ts1419" TIME_SLOT_REF2="ts1436">
                <ANNOTATION_VALUE>жест не начинается раньше, потому что я тянусь поправить волосы; возможно, это изобразительный, буквально жест показывает 1234</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2107"
                TIME_SLOT_REF1="ts1528" TIME_SLOT_REF2="ts1541">
                <ANNOTATION_VALUE>я решила, что кивок и "бе" это один жест; ну типо вот это такое бе и "да я понимаю ваще ужас"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2138"
                TIME_SLOT_REF1="ts1714" TIME_SLOT_REF2="ts1717">
                <ANNOTATION_VALUE>кажется, в конце особо нет жестов...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
